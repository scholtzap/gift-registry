# Caddy for the single-domain deployment: stock Caddy (public ACME, no DNS
# plugin), running as UID 10001 like the rest of the stack.
FROM caddy:2
# Stock caddy carries a file capability (cap_net_bind_service); with cap_drop ALL
# + no-new-privileges the kernel refuses to exec it. We bind 8443, so strip it.
RUN setcap -r /usr/bin/caddy || true
RUN mkdir -p /data /config /srv/pinata-site && chown -R 10001:10001 /data /config /srv
USER 10001:10001
