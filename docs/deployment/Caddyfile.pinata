# Single domain, two surfaces:
#   pinata.scholtz.work/         -> landing page (static files from site/public)
#   pinata.scholtz.work/app      -> the app hub (Next route /app, no base path)
#   pinata.scholtz.work/c/<slug> -> circles, /lookup, /api, app assets -> Next
#   pinata.scholtz.work/llms.txt -> Next GEO summary (site/public/llms.txt stays for gifts.scholtz.work)
# gifts.scholtz.work keeps serving the same landing page from Cloudflare Pages.
# Public ACME (TLS-ALPN) - no DNS plugin.
{
	admin off
	https_port 8443
	auto_https disable_redirects
}

{$CIRCLE_HOST} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
	}

	# Legacy links from the short-lived /app subpath deployment (2026-10-28),
	# when form actions rendered doubled (/app/app/create). Exact page first,
	# then the whole subtree: anything still carrying the doubled prefix lands
	# on the matching single-prefix URL instead of a 404.
	redir /app/app /app 308
	handle_path /app/app/* {
		redir https://{$CIRCLE_HOST}/app{path} 308
	}
	handle_path /app/c/* {
		redir https://{$CIRCLE_HOST}/c{path} 308
	}

	@app path /app /app/* /c/* /lookup /privacy /offline /health /llms.txt /api/* /_next/* /pinata.css /register-sw.js /sw.js /card-preview.js /manifest.webmanifest /icon.png /apple-icon.png /fonts/* /icons/* /screenshots/*
	handle @app {
		reverse_proxy app:3000 {
			header_up X-Forwarded-For {remote_host}
			header_up -Forwarded
			header_up -X-Real-IP
		}
	}

	handle {
		root * /srv/pinata-site
		try_files {path} {path}.html {path}/index.html
		file_server
	}
}
