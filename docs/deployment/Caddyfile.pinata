# Single-domain deployment: pinata.scholtz.work/ is the landing page (static
# files from site/public), pinata.scholtz.work/app/* is the app (Next built with
# PINATA_BASE_PATH=/app). gifts.scholtz.work keeps serving the same landing
# page from Cloudflare Pages. Public ACME (TLS-ALPN/HTTP-01) - no DNS plugin.
{
	admin off
	https_port 8443
	auto_https disable_redirects
}

{$CIRCLE_HOST} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
	}

	@app path /app /app/*
	handle @app {
		reverse_proxy app:3000 {
			header_up X-Forwarded-For {remote_host}
			header_up -Forwarded
			header_up -X-Real-IP
		}
	}

	handle {
		root * /srv/pinata-site
		try_files {path} {path}.html {path}/index.html
		file_server
	}
}
