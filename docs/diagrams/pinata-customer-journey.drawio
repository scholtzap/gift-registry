        <mxCell id="D1" value="WHATSAPP BOT&lt;br&gt;a find-a-friend task inside the&lt;br&gt;six bounded tasks&lt;br&gt;PARTIAL · rn-g-bot" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF4DC;strokeColor=#C2410C;strokeWidth=2;fontSize=14;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="190" y="546" width="260" height="131" as="geometry" /></mxCell>
        <mxCell id="D2" value="ON-PLATFORM WEB SEARCH&lt;br&gt;needs a crawlable index; noindex&lt;br&gt;is on every route today&lt;br&gt;BLOCKED · rn-h-crawl" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFE7F0;strokeColor=#E11D63;strokeWidth=2;dashed=1;dashPattern=6 4;fontSize=14;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="490" y="546" width="260" height="131" as="geometry" /></mxCell>
