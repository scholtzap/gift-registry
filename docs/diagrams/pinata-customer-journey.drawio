        <mxCell id="title" value="Piñata — intended customer journey: gifter and receiver" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=#14141C;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="34" as="geometry" /></mxCell>
        <mxCell id="sub" value="v3 · hackathon closed 2026-11-04; round-off in flow-simplification.&lt;br&gt;Track index: docs/plans/rn-tracks.md · plan: docs/plans/flow-simplification-circles-membership.md" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=#5B5B66;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1100" height="34" as="geometry" /></mxCell>
        <mxCell id="inv" value="JOIN STORY (2026-11-05): share-link auto-joins when signed in; /lookup lists discoverable public circles (always-200 hit/miss shell) and still offers proxy create; unsigned open still uses the phone allowlist gate." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E7F7EE;strokeColor=#0F9D58;strokeWidth=2;fontSize=13;fontColor=#14141C;align=center;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="2060" height="36" as="geometry" /></mxCell>
        <mxCell id="laneA" value="OWNER" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#0E7490;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="166" width="140" height="18" as="geometry" /></mxCell>
        <mxCell id="O1" value="CREATE A CIRCLE&lt;br&gt;one owner, one gated link&lt;br&gt;BUILT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E7F7EE;strokeColor=#0F9D58;strokeWidth=2;fontSize=14;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="190" y="188" width="260" height="93" as="geometry" /></mxCell>
        <mxCell id="O2" value="SET VISIBILITY&lt;br&gt;public or invite-only: a field&lt;br&gt;that does not exist yet&lt;br&gt;NEW · rn-a-spec" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E3EEFF;strokeColor=#1D6FE0;strokeWidth=2;dashed=1;dashPattern=6 4;fontSize=14;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="490" y="188" width="260" height="93" as="geometry" /></mxCell>
        <mxCell id="O3" value="PASTE THE LINK&lt;br&gt;into the WhatsApp group&lt;br&gt;BUILT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E7F7EE;strokeColor=#0F9D58;strokeWidth=2;fontSize=14;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="790" y="188" width="260" height="93" as="geometry" /></mxCell>
        <mxCell id="O4" value="OWNER LEDGER&lt;br&gt;sees progress, never what is&lt;br&gt;claimed&lt;br&gt;PARTIAL" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF4DC;strokeColor=#C2410C;strokeWidth=2;fontSize=14;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1090" y="188" width="260" height="93" as="geometry" /></mxCell>
        <mxCell id="O5" value="SEES REQUESTS&lt;br&gt;on their next visit; the system&lt;br&gt;never sends&lt;br&gt;NEW · rn-j" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E3EEFF;strokeColor=#1D6FE0;strokeWidth=2;dashed=1;dashPattern=6 4;fontSize=14;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1390" y="188" width="260" height="93" as="geometry" /></mxCell>
        <mxCell id="O6" value="HANDS OVER THE CARD&lt;br&gt;a human act: print, give, say&lt;br&gt;thanks&lt;br&gt;PARTIAL" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF4DC;strokeColor=#C2410C;strokeWidth=2;fontSize=14;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1690" y="188" width="260" height="93" as="geometry" /></mxCell>
        <mxCell id="laneB" value="GIFTER" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#0E7490;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="345" width="140" height="18" as="geometry" /></mxCell>
        <mxCell id="G1" value="SEES THE LINK&lt;br&gt;in the group, on a status, or&lt;br&gt;forwarded&lt;br&gt;BUILT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E7F7EE;strokeColor=#0F9D58;strokeWidth=2;fontSize=14;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="190" y="367" width="260" height="93" as="geometry" /></mxCell>
        <mxCell id="G2" value="LOOKS UP / OPENS LINK&lt;br&gt;discoverable list or empty&lt;br&gt;shell + proxy; signed-in&lt;br&gt;share link auto-joins&lt;br&gt;BUILT · flow-simplification" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E7F7EE;strokeColor=#0F9D58;strokeWidth=2;fontSize=14;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="490" y="367" width="260" height="93" as="geometry" /></mxCell>
        <mxCell id="G3" value="PASSES THE GATE&lt;br&gt;name + hashed allowlist match&lt;br&gt;BUILT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E7F7EE;strokeColor=#0F9D58;strokeWidth=2;fontSize=14;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="790" y="367" width="260" height="93" as="geometry" /></mxCell>
        <mxCell id="G4" value="VIEWS A PUBLIC REGISTRY&lt;br&gt;no login just to look&lt;br&gt;NEW · rn-h-crawl" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E3EEFF;strokeColor=#1D6FE0;strokeWidth=2;dashed=1;dashPattern=6 4;fontSize=14;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1090" y="367" width="260" height="93" as="geometry" /></mxCell>
        <mxCell id="G5" value="CLAIMS OR POOLS&lt;br&gt;money behind one assigned buyer&lt;br&gt;BUILT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E7F7EE;strokeColor=#0F9D58;strokeWidth=2;fontSize=14;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1390" y="367" width="260" height="93" as="geometry" /></mxCell>
        <mxCell id="G6" value="WRITES THE CARD LINE&lt;br&gt;their own words, on the card&lt;br&gt;BUILT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E7F7EE;strokeColor=#0F9D58;strokeWidth=2;fontSize=14;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1690" y="367" width="260" height="93" as="geometry" /></mxCell>
        <mxCell id="G7" value="SHARES THE PROXY LINK&lt;br&gt;onward to other friends; the&lt;br&gt;recipient never signs in&lt;br&gt;BUILT · rn-c-proxy" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E7F7EE;strokeColor=#0F9D58;strokeWidth=2;fontSize=14;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1990" y="367" width="260" height="93" as="geometry" /></mxCell>
