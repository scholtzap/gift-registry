        <mxCell id="mD3G4" value="a link, pasted or forwarded" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontSize=12;fontColor=#5B5B66;" vertex="1" parent="1"><mxGeometry x="881" y="478" width="193" height="13" as="geometry" /></mxCell>
        <mxCell id="wD1G2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F9D58;strokeWidth=2;exitX=0.55;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="D1" target="G2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="333" y="498" /><mxPoint x="672" y="498" /></Array></mxGeometry></mxCell>
        <mxCell id="mD1G2" value="the bot runs the search" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontSize=12;fontColor=#0F9D58;" vertex="1" parent="1"><mxGeometry x="677" y="502" width="166" height="13" as="geometry" /></mxCell>
        <mxCell id="notePrivacy" value="THE SPINE STAYS INTACT ON BOTH BRANCHES: owner and friend views remain&lt;br&gt;two projections of one ledger, the allowlist stays a keyed hash, every&lt;br&gt;registry route keeps no-store and noindex, and no model call runs before&lt;br&gt;can(actor, capability)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#E8E8EE;strokeWidth=2;fontSize=13;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="711" width="560" height="93" as="geometry" /></mxCell>
        <mxCell id="noteRisk" value="WHAT MAKES THIS NON-TRIVIAL: an always-200 lookup is why the route is&lt;br&gt;not an enumeration oracle, but it also lets anyone mint a circle in&lt;br&gt;anyone's name. rn-d-abuse-model gates rn-b-lookup-route before it ships." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#E8E8EE;strokeWidth=2;fontSize=13;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="790" y="711" width="560" height="74" as="geometry" /></mxCell>
        <mxCell id="noteOrder" value="READ THE TRACKS IN ORDER: rn-i first, then rn-a with rn-d, then rn-b&lt;br&gt;with rn-c, then rn-j, rn-e, rn-f, then rn-g. rn-h is a policy call." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#E8E8EE;strokeWidth=2;fontSize=13;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1390" y="711" width="560" height="55" as="geometry" /></mxCell>
        <mxCell id="lgT" value="KEY" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=#5B5B66;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="846" width="40" height="18" as="geometry" /></mxCell>
        <mxCell id="lg0" value="BUILT in main today" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F7EE;strokeColor=#0F9D58;strokeWidth=2;fontSize=13;fontColor=#14141C;" vertex="1" parent="1"><mxGeometry x="190" y="841" width="225" height="30" as="geometry" /></mxCell>
        <mxCell id="lg1" value="PARTIAL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4DC;strokeColor=#C2410C;strokeWidth=2;fontSize=13;fontColor=#14141C;" vertex="1" parent="1"><mxGeometry x="435" y="841" width="225" height="30" as="geometry" /></mxCell>
        <mxCell id="lg2" value="NEW — build required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3EEFF;strokeColor=#1D6FE0;strokeWidth=2;dashed=1;dashPattern=6 4;fontSize=13;fontColor=#14141C;" vertex="1" parent="1"><mxGeometry x="680" y="841" width="225" height="30" as="geometry" /></mxCell>
        <mxCell id="lg3" value="BLOCKED — platform or policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE7F0;strokeColor=#E11D63;strokeWidth=2;dashed=1;dashPattern=6 4;fontSize=13;fontColor=#14141C;" vertex="1" parent="1"><mxGeometry x="925" y="841" width="225" height="30" as="geometry" /></mxCell>
        <mxCell id="gen" value="Generated from a grid spec: uniform row heights, one bus lane per cross-lane wire.&lt;br&gt;Geometry checked by drawio_check.py — 0 crossings, 0 clipped blocks." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#A0A0AA;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1690" y="841" width="520" height="40" as="geometry" /></mxCell>
        <mxCell id="col" value="docs/diagrams/pinata-customer-journey.drawio · v3 · 2026-11-05 · join story: auto-join + discoverable lookup + proxy under More." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#A0A0AA;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="885" width="1400" height="16" as="geometry" /></mxCell>
      
        <mxCell id="meta-demo" value="&lt;b&gt;DEMO LOOP — the 3-minute video, in order (replayed by tests/browser/demo-loop.spec.ts before recording)&lt;/b&gt;&lt;br&gt;1 · Search a number → the same always-200 offer, whether or not a registry exists&lt;br&gt;2 · Create a proxy circle → paste /c/&lt;slug&gt; into the WhatsApp group&lt;br&gt;3 · A friend asks to join → the owner finds the request on their own link and lets them in&lt;br&gt;4 · Friends claim and pool behind one buyer → the owner sees wishes only, never the money&lt;br&gt;5 · After the day, the circle archives itself — the card stays with the friends" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=0;spacing=8;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="1240" height="140" as="geometry" /></mxCell>
        <mxCell id="meta-prog" value="&lt;b&gt;PROGRESS — 2026-11-05 · hackathon closed; flow-simplification round-off&lt;/b&gt;&lt;br&gt;Built: share-link auto-join · discoverable public-circle lookup (always-200) · friend dashboard Archived hide · event-date sort · registry suggestions on Add (hidden until Sharing)&lt;br&gt;Earlier: RN-C proxy · RN-E self-archiving · RN-J access requests · chrome nav. Human-gated: RN-F OTP template · RN-G bot find · RN-H crawl" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=0;spacing=8;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1124" width="1240" height="102" as="geometry" /></mxCell>
        <mxCell id="meta-stamp" value="&lt;b&gt;HUMAN VERIFIED / APPROVED — owner, 2026-11-05&lt;/b&gt;&lt;br&gt;Auto-join on share link; hackathon closed so public-circle lookup is in scope; archive = hide into collapsible Archived only. Recorded in docs/plans/flow-simplification-circles-membership.md and AGENTS.md.&lt;br&gt;Meta-side OTP template approval remains separate (WhatsApp Manager)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=0;spacing=8;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="1250" width="1240" height="102" as="geometry" /></mxCell>
