        <mxCell id="E4" value="Meta Graph API&lt;br&gt;friend graph not importable;&lt;br&gt;BSUID not resolvable&lt;br&gt;BLOCKED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFE7F0;strokeColor=#E11D63;strokeWidth=2;dashed=1;dashPattern=6 4;fontSize=14;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1090" y="563" width="260" height="93" as="geometry" /></mxCell>
