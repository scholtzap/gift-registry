        <mxCell id="C2" value="can(actor, capability)&lt;br&gt;one gate before every model call&lt;br&gt;BUILT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E7F7EE;strokeColor=#0F9D58;strokeWidth=2;fontSize=14;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="490" y="418" width="260" height="93" as="geometry" /></mxCell>
        <mxCell id="C3" value="reveal is a human act&lt;br&gt;no send, no notification, no og:&lt;br&gt;preview&lt;br&gt;BUILT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E7F7EE;strokeColor=#0F9D58;strokeWidth=2;fontSize=14;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="790" y="418" width="260" height="93" as="geometry" /></mxCell>
        <mxCell id="C4" value="leak suite&lt;br&gt;rendered-HTML proofs, not unit&lt;br&gt;asserts&lt;br&gt;BUILT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E7F7EE;strokeColor=#0F9D58;strokeWidth=2;fontSize=14;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1090" y="418" width="260" height="93" as="geometry" /></mxCell>
