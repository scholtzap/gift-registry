        <mxCell id="B1" value="circle handler&lt;br&gt;404 never 403; writes nothing&lt;br&gt;before it authorises&lt;br&gt;BUILT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E7F7EE;strokeColor=#0F9D58;strokeWidth=2;fontSize=14;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="190" y="273" width="260" height="93" as="geometry" /></mxCell>
        <mxCell id="B2" value="signed session cookie&lt;br&gt;SameSite=Lax, 14-day TTL&lt;br&gt;BUILT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E7F7EE;strokeColor=#0F9D58;strokeWidth=2;fontSize=14;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="490" y="273" width="260" height="93" as="geometry" /></mxCell>
        <mxCell id="B3" value="agent task menu&lt;br&gt;six bounded tasks, no free-form&lt;br&gt;chat&lt;br&gt;PARTIAL · rn-g-bot" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF4DC;strokeColor=#C2410C;strokeWidth=2;fontSize=14;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="790" y="273" width="260" height="93" as="geometry" /></mxCell>
