        <mxCell id="N1" value="/r/&lt;handle&gt; profile route&lt;br&gt;a persistent per-person URL&lt;br&gt;NEW · rn-b-lookup" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E3EEFF;strokeColor=#1D6FE0;strokeWidth=2;dashed=1;dashPattern=6 4;fontSize=13;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="190" y="708" width="260" height="93" as="geometry" /></mxCell>
        <mxCell id="N2" value="resolution lookup API&lt;br&gt;normalised E.164 key to registry&lt;br&gt;or none&lt;br&gt;NEW · rn-b-lookup" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E3EEFF;strokeColor=#1D6FE0;strokeWidth=2;dashed=1;dashPattern=6 4;fontSize=13;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="490" y="708" width="260" height="93" as="geometry" /></mxCell>
        <mxCell id="N3" value="OTP door&lt;br&gt;paid auth template; 7-day media&lt;br&gt;rule&lt;br&gt;NEW · rn-f-claim" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E3EEFF;strokeColor=#1D6FE0;strokeWidth=2;dashed=1;dashPattern=6 4;fontSize=13;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="790" y="708" width="260" height="93" as="geometry" /></mxCell>
        <mxCell id="N4" value="permission request + owner inbox&lt;br&gt;surfaced on visit, never pushed&lt;br&gt;NEW · rn-j" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E3EEFF;strokeColor=#1D6FE0;strokeWidth=2;dashed=1;dashPattern=6 4;fontSize=13;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1090" y="708" width="260" height="93" as="geometry" /></mxCell>
        <mxCell id="N5" value="proxy circle + visibility flag&lt;br&gt;made by a friend, archived after&lt;br&gt;the day&lt;br&gt;NEW · rn-c-proxy rn-e-lifecycle" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E3EEFF;strokeColor=#1D6FE0;strokeWidth=2;dashed=1;dashPattern=6 4;fontSize=13;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1390" y="708" width="260" height="93" as="geometry" /></mxCell>
        <mxCell id="N6" value="REQUEST_CONTACT_INFO button&lt;br&gt;self-declared numbers, no import&lt;br&gt;NEW · rn-i-triage" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E3EEFF;strokeColor=#1D6FE0;strokeWidth=2;dashed=1;dashPattern=6 4;fontSize=13;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1690" y="708" width="260" height="93" as="geometry" /></mxCell>
        <mxCell id="N7" value="crawlability policy call&lt;br&gt;index public registries or keep&lt;br&gt;them dark&lt;br&gt;NEW · rn-h-crawl" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E3EEFF;strokeColor=#1D6FE0;strokeWidth=2;dashed=1;dashPattern=6 4;fontSize=13;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1990" y="708" width="260" height="93" as="geometry" /></mxCell>
        <mxCell id="zE4N6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E11D63;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="E4" target="N6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1220" y="668" /><mxPoint x="1820" y="668" /></Array></mxGeometry></mxCell>
        <mxCell id="mE4N6" value="blocked → substitute" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontSize=12;fontColor=#E11D63;" vertex="1" parent="1"><mxGeometry x="1234" y="672" width="146" height="13" as="geometry" /></mxCell>
        <mxCell id="zE1N3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1D6FE0;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="E1" target="N3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="320" y="690" /><mxPoint x="920" y="690" /></Array></mxGeometry></mxCell>
        <mxCell id="mE1N3" value="OTP is a WhatsApp template, not a form" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontSize=12;fontColor=#1D6FE0;" vertex="1" parent="1"><mxGeometry x="290" y="694" width="267" height="13" as="geometry" /></mxCell>
        <mxCell id="noteRead" value="HOW TO READ IT: the four upper bands are the spine that already holds.&lt;br&gt;That is why the new layer is a thin shell rather than a rewrite — RLS,&lt;br&gt;the capability gate and the two projections stay exactly as they are." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#E8E8EE;strokeWidth=2;fontSize=13;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="835" width="560" height="74" as="geometry" /></mxCell>
        <mxCell id="noteBlocks" value="HARD BLOCKS: Meta exposes no importable friend graph and no way to&lt;br&gt;resolve a BSUID to a person. Discovery has to run on our own data, which&lt;br&gt;is what N2 and N6 are for." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFE7F0;strokeColor=#E11D63;strokeWidth=2;fontSize=13;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="790" y="835" width="560" height="74" as="geometry" /></mxCell>
        <mxCell id="noteGap" value="THE GAP THAT CANNOT BE PATCHED LATER: B4. No owner session means no&lt;br&gt;owner who can set visibility, approve a request, or claim a proxy&lt;br&gt;circle. rn-a-spec decides this before any route is written." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF4DC;strokeColor=#C2410C;strokeWidth=2;fontSize=13;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1390" y="835" width="560" height="74" as="geometry" /></mxCell>
        <mxCell id="lgT" value="KEY" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=#5B5B66;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="970" width="40" height="18" as="geometry" /></mxCell>
        <mxCell id="lg0" value="BUILT in main today" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F7EE;strokeColor=#0F9D58;strokeWidth=2;fontSize=13;fontColor=#14141C;" vertex="1" parent="1"><mxGeometry x="190" y="965" width="225" height="30" as="geometry" /></mxCell>
        <mxCell id="lg1" value="PARTIAL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4DC;strokeColor=#C2410C;strokeWidth=2;fontSize=13;fontColor=#14141C;" vertex="1" parent="1"><mxGeometry x="435" y="965" width="225" height="30" as="geometry" /></mxCell>
        <mxCell id="lg2" value="NEW — build required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3EEFF;strokeColor=#1D6FE0;strokeWidth=2;dashed=1;dashPattern=6 4;fontSize=13;fontColor=#14141C;" vertex="1" parent="1"><mxGeometry x="680" y="965" width="225" height="30" as="geometry" /></mxCell>
        <mxCell id="lg3" value="BLOCKED — platform or policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE7F0;strokeColor=#E11D63;strokeWidth=2;dashed=1;dashPattern=6 4;fontSize=13;fontColor=#14141C;" vertex="1" parent="1"><mxGeometry x="925" y="965" width="225" height="30" as="geometry" /></mxCell>
        <mxCell id="gen" value="Generated from a grid spec. New-layer wires run down a reserved right-hand gutter,<br>one per bus lane, so no wire can pass through a tile it does not end at." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#A0A0AA;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1690" y="965" width="520" height="40" as="geometry" /></mxCell>
        <mxCell id="col" value="docs/diagrams/pinata-registry-network-buildmap.drawio · v2 · 2026-10-27 · geometry checked by drawio_check.py" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#A0A0AA;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1009" width="1400" height="16" as="geometry" /></mxCell>
