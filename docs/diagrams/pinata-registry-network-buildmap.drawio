        <mxCell id="A1" value="/c/&lt;slug&gt; circle route&lt;br&gt;the URL pasted into a WhatsApp&lt;br&gt;group; it never moves&lt;br&gt;BUILT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E7F7EE;strokeColor=#0F9D58;strokeWidth=2;fontSize=14;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="190" y="128" width="260" height="93" as="geometry" /></mxCell>
        <mxCell id="A2" value="/app&lt;br&gt;no login and no search; a stub&lt;br&gt;today&lt;br&gt;PARTIAL · rn-b-lookup" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF4DC;strokeColor=#C2410C;strokeWidth=2;fontSize=14;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="490" y="128" width="260" height="93" as="geometry" /></mxCell>
        <mxCell id="A3" value="WhatsApp webhook&lt;br&gt;HMAC-verified, media bytes&lt;br&gt;pulled on ingest&lt;br&gt;BUILT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E7F7EE;strokeColor=#0F9D58;strokeWidth=2;fontSize=14;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="790" y="128" width="260" height="93" as="geometry" /></mxCell>
        <mxCell id="A4" value="gate POST&lt;br&gt;name + number into a hashed&lt;br&gt;allowlist lookup&lt;br&gt;BUILT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E7F7EE;strokeColor=#0F9D58;strokeWidth=2;fontSize=14;fontColor=#14141C;align=left;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1090" y="128" width="260" height="93" as="geometry" /></mxCell>
