        <mxCell id="title" value="Pi&#241;ata &#8212; build map: the shipped spine against the registry-network layer the intended journey asks for" style="text;html=1;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#14141C;" vertex="1" parent="1">
          <mxGeometry x="32" y="20" width="1600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Read top to bottom: what a person arrives through, what authorises them, what the app already guarantees, what it calls outside itself, and the new layer that does not exist yet." style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#5B5B66;" vertex="1" parent="1">
          <mxGeometry x="32" y="58" width="1600" height="26" as="geometry" />
        </mxCell>

        <mxCell id="zbound" value="REGISTRY-NETWORK LAYER &#8212; ENTIRELY NEW  &#183;  one persistent link per person, not one gated link per event  &#183;  SPEC.md lists this as out of scope for v1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#E3EEFF;fillOpacity=35;strokeColor=#1D6FE0;strokeWidth=2;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=10;fontSize=16;fontStyle=1;fontColor=#1D6FE0;" vertex="1" parent="1">
