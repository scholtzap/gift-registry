        <mxCell id="title" value="Piñata — build map: what holds the line today, and what has to be built" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=#14141C;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="34" as="geometry" /></mxCell>
        <mxCell id="sub" value="Five layers, top to bottom. The last band is the registry-network layer: entirely new work.<br>Every tile names the plan track that owns it. Track index: docs/plans/rn-tracks.md" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=#5B5B66;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1300" height="34" as="geometry" /></mxCell>
