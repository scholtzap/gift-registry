        <mxCell id="title" value="Pi&#241;ata &#8212; discovery and access: how a person finds a registry and is allowed to act on it" style="text;html=1;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#14141C;" vertex="1" parent="1">
          <mxGeometry x="32" y="20" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Three entry paths converge on one resolution check, then fork on the registry's visibility setting. Green tiles are the gate that ships today; blue dashed tiles are the work." style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#5B5B66;" vertex="1" parent="1">
          <mxGeometry x="32" y="58" width="1600" height="26" as="geometry" />
