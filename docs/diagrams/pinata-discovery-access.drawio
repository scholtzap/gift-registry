        <mxCell id="noteGuard" value="GUARDRAILS THIS FLOW KEEPS&lt;br&gt;404 never 403 on a miss &#183; no-store + noindex on every registry route&lt;br&gt;allowlist stays a keyed hash &#183; the gate writes nothing before it authorises" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#E8E8EE;strokeWidth=2;fontSize=13;fontColor=#5B5B66;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
