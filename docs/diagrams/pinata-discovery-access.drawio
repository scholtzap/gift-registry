        <mxCell id="title" value="Pi&#241;ata &#8212; search a number, get an answer" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#14141C;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="36" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="One lookup, two branches. Green ships today, blue dashed is the work.<br>Every gap tile names the plan track that closes it." style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#5B5B66;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="700" height="34" as="geometry" />
        </mxCell>

        <mxCell id="inv" value="THE INVARIANT: every lookup answers 200. Found renders their registry; not found offers a proxy circle.<br>A caller who guesses a number never learns whether it is registered, so the route is not an enumeration oracle." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFE7F0;strokeColor=#E11D63;strokeWidth=2;fontSize=14;fontColor=#14141C;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="96" width="1460" height="54" as="geometry" />
        </mxCell>

        <mxCell id="T1" value="SEARCHES PI&#205;ATA&lt;br&gt;phone or handle, on web or in the bot&lt;br&gt;NEW &#183; rn-g-bot-find-task.md" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E3EEFF;strokeColor=#1D6FE0;strokeWidth=2;dashed=1;dashPattern=6 4;fontSize=15;fontColor=#14141C;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="360" y="180" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="T2" value="RESOLUTION LOOKUP&lt;br&gt;normalised E.164 key, hashed&lt;br&gt;never a number in a URL&lt;br&gt;NEW &#183; rn-b-lookup-route.md" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E3EEFF;strokeColor=#1D6FE0;strokeWidth=2;dashed=1;dashPattern=6 4;fontSize=15;fontColor=#14141C;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="360" y="310" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="T3" value="Does that number&lt;br&gt;resolve?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14141C;strokeWidth=2;fontSize=16;fontColor=#14141C;" vertex="1" parent="1">
          <mxGeometry x="360" y="460" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="T4" value="Is that registry&lt;br&gt;public?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14141C;strokeWidth=2;fontSize=16;fontColor=#14141C;" vertex="1" parent="1">
          <mxGeometry x="360" y="620" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="T5" value="GATE + OTP DOOR&lt;br&gt;name + allowlist hash match&lt;br&gt;OTP is a paid auth template&lt;br&gt;&lt;br&gt;BUILT &#183; OTP NEW &#183; rn-a-spec.md" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF4DC;strokeColor=#C2410C;strokeWidth=2;fontSize=15;fontColor=#14141C;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="360" y="790" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="T6" value="SESSION, FRIEND PROJECTION&lt;br&gt;signed cookie, 14-day TTL&lt;br&gt;BUILT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E7F7EE;strokeColor=#0F9D58;strokeWidth=2;fontSize=15;fontColor=#14141C;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="360" y="960" width="320" height="80" as="geometry" />
        </mxCell>

        <mxCell id="R1" value="NOT REGISTERED &#8594; CREATE A PROXY CIRCLE&lt;br&gt;A friend registers the recipient&lt;br&gt;without their account or consent.&lt;br&gt;No name, no number is stored.&lt;br&gt;Once-off &#8212; it archives after the day.&lt;br&gt;&lt;br&gt;NEW &#183; rn-c-proxy-circle.md&lt;br&gt;rn-e-lifecycle-archive.md" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E3EEFF;strokeColor=#1D6FE0;strokeWidth=2;dashed=1;dashPattern=6 4;fontSize=14;fontColor=#14141C;verticalAlign=top;spacingTop=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="1140" y="440" width="360" height="160" as="geometry" />
        </mxCell>
        <mxCell id="R2" value="THE PROXY LINK&lt;br&gt;Unguessable slug, fixed for this gift.&lt;br&gt;Pasted on status, forwarded on.&lt;br&gt;NEW &#183; rn-c-proxy-circle.md&lt;br&gt;rn-h-crawlability.md" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E3EEFF;strokeColor=#1D6FE0;strokeWidth=2;dashed=1;dashPattern=6 4;fontSize=14;fontColor=#14141C;verticalAlign=top;spacingTop=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="1140" y="820" width="360" height="120" as="geometry" />
        </mxCell>

