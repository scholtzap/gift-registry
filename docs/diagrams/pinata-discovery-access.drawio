        <mxCell id="mIG" value="no match" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontSize=12;fontColor=#7A8399;" vertex="1" parent="1"><mxGeometry x="900" y="542" width="70" height="12" as="geometry" /></mxCell>

        <mxCell id="noteLoop" value="PERMISSION-REQUEST LOOP (NEW, both branches): a person who fails the gate or lands on a private registry can ask the owner for access. The owner's request inbox does not exist, and a push notification to the owner would break the rule that the system never delivers a message &#8212; so the request must be surfaced when the owner next opens their own link, not sent. Approval adds a hashed allowlist entry and returns the same gated link to the requester." style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontColor=#1D6FE0;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="390" y="760" width="1250" height="70" as="geometry" />
        </mxCell>

        <mxCell id="legline" style="line;shape=line;direction=north;strokeColor=#E8E8EE;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="32" y="840" width="1698" height="1" as="geometry" /></mxCell>
        <mxCell id="lg" value="LEGEND" style="text;html=1;align=left;fontSize=14;fontColor=#5B5B66;" vertex="1" parent="1"><mxGeometry x="32" y="856" width="90" height="20" as="geometry" /></mxCell>
        <mxCell id="lg1" value="BUILT in main today" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F7EE;strokeColor=#0F9D58;strokeWidth=2;fontSize=14;fontColor=#14141C;" vertex="1" parent="1"><mxGeometry x="130" y="856" width="180" height="36" as="geometry" /></mxCell>
        <mxCell id="lg2" value="PARTIAL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4DC;strokeColor=#C2410C;strokeWidth=2;fontSize=14;fontColor=#14141C;" vertex="1" parent="1"><mxGeometry x="326" y="856" width="120" height="36" as="geometry" /></mxCell>
        <mxCell id="lg3" value="NEW &#8212; build required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3EEFF;strokeColor=#1D6FE0;strokeWidth=2;dashed=1;dashPattern=6 4;fontSize=14;fontColor=#14141C;" vertex="1" parent="1"><mxGeometry x="462" y="856" width="180" height="36" as="geometry" /></mxCell>
        <mxCell id="lg4" value="Decision" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14141C;strokeWidth=2;fontSize=14;fontColor=#14141C;" vertex="1" parent="1"><mxGeometry x="658" y="856" width="120" height="36" as="geometry" /></mxCell>
        <mxCell id="lg5" value="PINK = the new public path" style="text;html=1;align=left;fontSize=14;fontColor=#E11D63;" vertex="1" parent="1"><mxGeometry x="800" y="864" width="260" height="20" as="geometry" /></mxCell>
        <mxCell id="lg6" value="Grey dashed = conditional" style="text;html=1;align=left;fontSize=14;fontColor=#5B5B66;" vertex="1" parent="1"><mxGeometry x="1080" y="864" width="260" height="20" as="geometry" /></mxCell>

        <mxCell id="noteGuard" value="GUARDRAILS THIS FLOW MUST KEEP: 404 never 403 on every miss &#183; no-store and noindex on every registry route &#183; allowlist stays a keyed hash, never digits &#183; the gate writes nothing until it has authorised &#183; same-origin check on the POST that mints a session." style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontColor=#5B5B66;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="32" y="900" width="1698" height="40" as="geometry" />
        </mxCell>

        <mxCell id="colophon" value="docs/diagrams/pinata-discovery-access.drawio &#183; v1 &#183; 2026-10-27 &#183; Qoder &#183; evidence: src/server/routes/circle.ts:397-451 (gate), src/server/auth/phone-hash.ts, src/server/auth/session.ts:95-108" style="text;html=1;align=left;fontSize=12;fontColor=#A0A0AA;" vertex="1" parent="1">
          <mxGeometry x="32" y="944" width="1500" height="20" as="geometry" />
        </mxCell>
