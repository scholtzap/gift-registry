{
  "version": 1,
  "hooks": {
    "stop": [
      {
        "command": "python .cursor/hooks/mistakes_audit.py",
        "loop_limit": 1,
        "timeout": 20
      },
      {
        "command": "python .cursor/hooks/wishlist_audit.py",
        "loop_limit": 1,
        "timeout": 20
      },
      {
        "command": "python .cursor/hooks/plans_registry_audit.py",
        "loop_limit": 1,
        "timeout": 20
      }
    ],
    "sessionEnd": [
      {
        "command": "python .cursor/hooks/mistakes_audit.py",
        "timeout": 20
      },
      {
        "command": "python .cursor/hooks/wishlist_audit.py",
        "timeout": 20
      },
      {
        "command": "python .cursor/hooks/plans_registry_audit.py",
        "timeout": 20
      }
    ]
  }
}
