# Copy to .env (untracked). Never put a real key in this file — it is committed.
# Docs KB sync is CI-owned: NOTION_API_KEY lives only as a GitHub Actions secret.
DOC_SYNC_TARGET=notion
NOTION_ROOT_PAGE_ID=
NOTION_ACCOUNT_EMAIL=

# Meta API. Values live in Vaultwarden (secrets-mcp), not here.
# META_GIFT_API_KEY: repo=gift-registry env=single (deployed app + tests)
META_GIFT_API_KEY=

# --- app ---
# `gifts`/`gifts` is the local dev container's superuser, not a production credential.
# On the VM these come from the secrets file that docker compose reads, never from this repo.
DATABASE_URL=postgresql://gifts:gifts@127.0.0.1:5433/gifts
# The leak suite never runs against dev data. Same server, separate database.
DATABASE_URL_TEST=postgresql://gifts:gifts@127.0.0.1:5433/gifts_test
# Read by docker-compose.yml to initialise that container.
POSTGRES_USER=gifts
POSTGRES_PASSWORD=gifts
POSTGRES_DB=gifts
SESSION_SECRET=replace-with-32-plus-random-chars-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
# Distinct from SESSION_SECRET (RN-D M6): boot refuses to start if they match.
PHONE_HASH_PEPPER=replace-with-a-different-32-plus-random-chars-bbbbbbbbbbbbbbbbbbbb
CIRCLE_BASE_URL=https://circles.example.test
PORT=3000
# Production only: the app runs behind Caddy (docs/deployment/Caddyfile.pinata),
# which overwrites X-Forwarded-For at the proxy. Set TRUSTED_PROXY=on in the VM
# secrets file so throttle keys see real client addresses and the shared Postgres
# throttle budget activates. Leave off locally: the demo has no proxy, so an
# untrusted forwarding header must never be honoured. Never commit "on" here.
TRUSTED_PROXY=off

# --- Meta Model API (key comes from your secrets manager, prefixed LLM_) ---
MODEL_API_KEY=
# Max billable model calls per owner per day (UTC). Friends spend the owner's
# budget. Set to 0 to pause all live model use (demo fixtures still work).
MODEL_DAILY_SPEND_LIMIT=200
MODEL_API_BASE_URL=https://api.meta.ai/v1
# 1.2 for anything with pixels or audio in it; 1.3 is text-only reasoning (Spark 1.3 audio is
# documented as degraded). See ARCHITECTURE.md §5.
MODEL_INTAKE=muse-spark-1.2
MODEL_VISION=muse-spark-1.2
MODEL_TRANSCRIBE=muse-voice-transcribe-1.0
MODEL_IMAGE=muse-image-1.0

# --- WhatsApp Cloud API ---
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# The WhatsApp Business Account (WABA) asset ID. An identifier, not a credential.
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_API_VERSION=v23.0

# --- bot gate (Cloudflare Turnstile; set BOTH before external users) ---
# Server-side verification secret. Unset = open seam for dev/demo/test.
TURNSTILE_SECRET=
# Public site key rendered as the checkbox widget in the gate/hub/lookup forms.
TURNSTILE_SITE_KEY=

# --- ingest ---
MEDIA_DIR=./.media
FFMPEG_PATH=ffmpeg

# on = deterministic fixtures instead of live model calls. The demo must never be
# recorded with this on; every ingest row records which path produced it.
DEMO_MODE=off
# Sign-in mail. Leave both empty while DEMO_MODE=on. RESEND_API_KEY is the vault
# item of that name (shared / single). OTP_FROM_EMAIL must be on a domain verified
# in Resend. Demo mode logs the code and sends nothing.
RESEND_API_KEY=
OTP_FROM_EMAIL=
