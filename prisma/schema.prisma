// Gift Circles — single system of record is Postgres 16.
// Money is always integer minor units + an explicit currency; never a float.
// RLS is NOT expressible here — it lives in server/db/policies/*.sql (see ARCHITECTURE §4).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AttributeKind {
  ring_size
  shoe_size
  top
  bottom
  colour
  other
}

enum AttributeVisibility {
  friends
  private
}

enum CircleStatus {
  active
  closed
  // RN-E: terminal state for a once-off (proxy) circle after its day.
  archived
}

enum AllowlistStatus {
  pending
  accepted
  removed
}

enum MembershipRole {
  owner
  friend
}

enum MembershipStatus {
  active
  removed
}

enum ItemVisibility {
  owner_visible
  friend_only
}

enum ItemStatus {
  active
  tombstoned
  revealed
}

enum TombstoneReason {
  bought_self
  no_longer_wants
  duplicate
}

enum ClaimKind {
  solo
  pool_member
}

enum ClaimStatus {
  claimed
  fulfilled
  released
}

enum PoolStatus {
  open
  funded
  purchased
  pivot_needed
}

enum ContributionStatus {
  promised
  marked_paid
  settled
}

enum IngestKind {
  audio
  image
  text
  url
}

enum IngestStatus {
  received
  converted
  transcribed
  parsed
  confirmed
  failed
}

enum UserPlan {
  free
  premium
  internal
}

/// One switch per model-spending path (SPEC.md §Decisions v1.1). `deal_search` exists before
/// the feature does, so reviving the deferred deal spike needs no migration.
enum AiCapability {
  voice_transcribe
  photo_extract
  link_expand
  card_pun
  card_art
  assistant_reply
  deal_search
}

/// Why a switch is in the state it is in. A row the user set must survive a plan change; a row
/// a plan granted must not. `subscription` is here so paid tiers are data, not a migration.
enum EntitlementSource {
  user
  plan_default
  admin
  subscription
}

model User {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bsuid       String?   @unique
  /// Plaintext, like `phoneE164`: the login role reads it to send a code.
  /// App roles are not granted this column. Lookup uses `emailHash`.
  email       String?   @unique
  /// HMAC of `email:` + the normalised address, peppered with `PHONE_HASH_PEPPER`.
  emailHash   String?   @unique @map("email_hash")
  phoneE164   String?   @unique @map("phone_e164")
  displayName String    @map("display_name")
  /// Supplies the default when a capability has no `entitlements` row. Adding it with a
  /// non-volatile default is expand-only: the previous image tag still runs against it.
  plan        UserPlan  @default(free)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  attributes      Attribute[]
  ownedCircles    Circle[]
  addedAllowlist  AllowlistEntry[]
  memberships     Membership[]
  addedItems      Item[]          @relation("added")
  claims          Claim[]
  poolsAsBuyer    Pool[]
  payoutsAsBuyer  PoolPayout[]    @relation("payout_buyer")
  contributions   Contribution[]
  ingestEvents    IngestEvent[]
  ledgerEvents    LedgerEvent[]
  cardEntries     CardEntry[]
  giftCards       GiftCard[]
  entitlements    Entitlement[]
  revealedItems   Item[]          @relation("revealed")
  eventDateWrites Circle[]        @relation("event_date_writer")
  otpCodes        OtpCode[]
  registryItems   RegistryItem[]
  circleLinksAdded CircleItemLink[] @relation("link_added_by")

  @@map("users")
}

/// Per-user AI capability switches: one row per `(user, capability)`, upserted so a double tap
/// cannot create two conflicting rows. Rendered **only** in the actor's own settings screen —
/// never in the owner projection, never in the friend projection (SPEC.md F12 step 4).
model Entitlement {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String            @map("user_id") @db.Uuid
  capability AiCapability
  enabled    Boolean           @default(true)
  source     EntitlementSource @default(user)
  expiresAt  DateTime?         @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, capability])
  @@index([userId])
  @@map("entitlements")
}

model Attribute {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  kind      AttributeKind
  valueText String              @map("value_text")
  unit      String?
  visibility AttributeVisibility @default(friends)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, valueText])
  @@index([userId])
  @@map("attributes")
}

model Circle {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  occasion    String
  /// The real birthday, never derived from `eventDate`. Month and day only unless the owner
  /// chose to supply a year: a full date of birth is sensitive data and lets anyone compute an age.
  birthMonth  Int?          @map("birth_month") @db.SmallInt
  birthDay    Int?          @map("birth_day") @db.SmallInt
  birthYear   Int?          @map("birth_year") @db.SmallInt
  eventDate   DateTime?     @map("event_date") @db.Date
  /// Who last wrote `eventDate`, and the whole secrecy rule: the owner projection renders the
  /// date only when this names the owner. Null only after that person was deleted.
  eventDateSetByUserId String?   @map("event_date_set_by_user_id") @db.Uuid
  // Nullable for proxy circles (RN-A D2): a registry created for someone with
  // no account has no owner row, and must not invent one.
  ownerUserId String?       @map("owner_user_id") @db.Uuid
  // Proxy-circle recipient, as a keyed digest only (RN-A D3). Never plaintext.
  recipientLabel         String? @map("recipient_label")
  recipientPhoneE164Hash String? @map("recipient_phone_e164_hash")
  proxyCreatedByUserId   String? @map("proxy_created_by_user_id") @db.Uuid
  /// Currency new items in this circle default to. Per-item currency still wins.
  defaultCurrency String    @default("USD") @map("default_currency") @db.Char(3)
  shareSlug   String        @unique @map("share_slug")
  /// Stored, unused by sign-in. Owner return is the email code either way.
  discoverable Boolean      @default(false)
  /// Where the gift is handed over. Null until someone writes it.
  locationNote String?      @map("location_note")
  status      CircleStatus  @default(active)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  owner          User?            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  eventDateSetBy User?            @relation("event_date_writer", fields: [eventDateSetByUserId], references: [id], onDelete: SetNull)
  allowlist      AllowlistEntry[]
  memberships    Membership[]
  items          Item[]
  ingestEvents   IngestEvent[]
  ledgerEvents   LedgerEvent[]
  itemLinks      CircleItemLink[]

  @@index([ownerUserId])
  @@map("circles")
}

model AllowlistEntry {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  circleId      String          @map("circle_id") @db.Uuid
  phoneE164Hash String          @map("phone_e164_hash")
  addedBy       String          @map("added_by") @db.Uuid
  status        AllowlistStatus @default(pending)
  // RN-J: set only on a permission *request* (a stranger asking), never on an
  // owner's invitation. The gate must not honour a row that carries it until
  // the owner approves, which clears it. The name is the requester's own
  // untrusted words and renders in the owner projection only.
  requesterName String?         @map("requester_name")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  addUser User  @relation(fields: [addedBy], references: [id], onDelete: Cascade)

  @@unique([circleId, phoneE164Hash])
  @@index([circleId, status])
  @@map("allowlist_entries")
}

model Membership {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  circleId  String           @map("circle_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      MembershipRole   @default(friend)
  status    MembershipStatus @default(active)
  /// Per-user dashboard hide only. Does not leave the circle or touch the ledger.
  dashboardHidden Boolean    @default(false) @map("dashboard_hidden")
  joinedAt  DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([circleId, userId])
  @@index([userId, status])
  @@map("memberships")
}

model Item {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  circleId       String           @map("circle_id") @db.Uuid
  title          String
  canonicalUrl   String?          @map("canonical_url")
  retailer       String?
  priceMinor     Int?             @map("price_minor")
  currency       String           @default("USD") @db.Char(3)
  imagePath      String?          @map("image_path")
  addedByUserId  String           @map("added_by_user_id") @db.Uuid
  visibility     ItemVisibility   @default(owner_visible)
  status         ItemStatus       @default(active)
  tombstoneReason TombstoneReason? @map("tombstone_reason")
  confirmed      Boolean          @default(false)
  /// Author's veto on the post-event reveal (SPEC.md F14). `false` means never revealed, by
  /// anyone, at any time — the reveal route 404s rather than explaining itself.
  revealOk       Boolean          @default(true) @map("reveal_ok")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  tombstonedAt   DateTime?        @map("tombstoned_at") @db.Timestamptz(6)
  revealedAt     DateTime?        @map("revealed_at") @db.Timestamptz(6)
  revealedByUserId String?        @map("revealed_by_user_id") @db.Uuid

  circle       Circle        @relation(fields: [circleId], references: [id], onDelete: Cascade)
  addedBy      User          @relation("added", fields: [addedByUserId], references: [id], onDelete: Cascade)
  revealedBy   User?         @relation("revealed", fields: [revealedByUserId], references: [id], onDelete: SetNull)
  claims       Claim[]
  pools        Pool[]
  ingestEvents IngestEvent[]
  cardEntries  CardEntry[]
  giftCard     GiftCard?

  @@index([circleId, status])
  @@index([circleId, visibility])
  @@map("items")
}

model Claim {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId    String      @map("item_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  poolId    String?     @map("pool_id") @db.Uuid
  kind      ClaimKind
  status    ClaimStatus @default(claimed)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  item Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  pool Pool? @relation(fields: [poolId], references: [id], onDelete: SetNull)

  @@unique([itemId, userId])
  @@index([poolId])
  @@map("claims")
}

model Pool {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId      String     @map("item_id") @db.Uuid
  buyerUserId String     @map("buyer_user_id") @db.Uuid
  targetMinor Int        @map("target_minor")
  currency    String     @default("USD") @db.Char(3)
  status      PoolStatus @default(open)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  item          Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  buyer         User           @relation(fields: [buyerUserId], references: [id], onDelete: Cascade)
  claims        Claim[]
  contributions Contribution[]
  payout        PoolPayout?

  @@index([itemId, status])
  @@map("pools")
}

/// Where pledgers send their share by hand. Written by the pool's buyer only;
/// pledgers read it only once they pledged and the buyer switched sharing on.
/// The owner has no read policy on this table and stays blind to it.
model PoolPayout {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  poolId          String   @unique @map("pool_id") @db.Uuid
  buyerUserId     String   @map("buyer_user_id") @db.Uuid
  accountHolder   String   @map("account_holder")
  bankName        String   @map("bank_name")
  accountNumber   String   @map("account_number")
  branchCode      String   @map("branch_code")
  accountType     String?  @map("account_type")
  referencePrefix String?  @map("reference_prefix")
  shareConsent    Boolean  @default(false) @map("share_consent")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  pool  Pool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  buyer User @relation("payout_buyer", fields: [buyerUserId], references: [id], onDelete: Cascade)

  @@index([buyerUserId])
  @@map("pool_payouts")
}

model Contribution {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  poolId      String             @map("pool_id") @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  amountMinor Int                @map("amount_minor")
  currency    String             @default("USD") @db.Char(3)
  status      ContributionStatus @default(promised)
  paidAt      DateTime?          @map("paid_at") @db.Timestamptz(6)
  note        String?
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  pool Pool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([poolId, userId])
  @@map("contributions")
}

model IngestEvent {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  waMessageId    String       @unique @map("wa_message_id")
  circleId       String       @map("circle_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  kind           IngestKind
  mediaPath      String?      @map("media_path")
  mediaExpiresAt DateTime?    @map("media_expires_at") @db.Timestamptz(6)
  modelUsed      String?      @map("model_used")
  draft          Json?
  itemId         String?      @map("item_id") @db.Uuid
  status         IngestStatus @default(received)
  error          String?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  item   Item?  @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([circleId, status])
  @@map("ingest_events")
}

model LedgerEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  circleId    String   @map("circle_id") @db.Uuid
  entity      String
  entityId    String   @map("entity_id")
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  payload     Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([circleId, createdAt])
  @@map("ledger_events")
}

/// One row per gift-giver. The card is composed from these, never stored as one blob.
model CardEntry {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId            String   @map("item_id") @db.Uuid
  contributorUserId String   @map("contributor_user_id") @db.Uuid
  displayNameShown  String   @map("display_name_shown")
  anonymous         Boolean  @default(false)
  message           String
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  item        Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  contributor User @relation(fields: [contributorUserId], references: [id], onDelete: Cascade)

  @@unique([itemId, contributorUserId])
  @@map("card_entries")
  // A card is handed to the gift target in a WhatsApp group: a runaway message would
  // turn a keepsake into a wall of text, and a URL would smuggle a retailer to the owner.
}

/// Derived state, not ledger state: deleting a card never touches contributions.
model GiftCard {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId           String   @unique @map("item_id") @db.Uuid
  pun              String
  tagline          String
  modelUsed        String?  @map("model_used")
  artPath          String?  @map("art_path")
  artPrompt        String?  @map("art_prompt")
  renderedPngPath  String?  @map("rendered_png_path")
  renderedAt       DateTime? @map("rendered_at") @db.Timestamptz(6)
  createdByUserId  String   @map("created_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  item      Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@map("gift_cards")
}

/// Login codes. The login role reads them. App roles are denied by policy.
/// `phoneE164Hash` keeps the original column; it stores whichever identifier
/// hash was submitted. `identifierHash` is the lookup key.
model OtpCode {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phoneE164Hash  String   @map("phone_e164_hash")
  identifierHash String?  @map("identifier_hash")
  userId         String   @map("user_id") @db.Uuid
  codeHash       String   @map("code_hash")
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  attempts       Int      @default(0)
  used           Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phoneE164Hash, expiresAt])
  @@index([identifierHash, expiresAt])
  @@map("otp_codes")
}

/// One row per thing the receiver wants, shared across their circles.
model RegistryItem {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId   String   @map("owner_user_id") @db.Uuid
  title         String
  canonicalUrl  String?  @map("canonical_url")
  retailer      String?
  priceMinor    Int?     @map("price_minor")
  currency      String   @default("USD") @db.Char(3)
  imagePath     String?  @map("image_path")
  private       Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  owner User             @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  links CircleItemLink[]

  @@index([ownerUserId])
  @@map("registry_items")
}

/// Per-circle visibility of a canonical item. Hidden until the receiver previews that circle.
model CircleItemLink {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  registryItemId  String    @map("registry_item_id") @db.Uuid
  circleId        String    @map("circle_id") @db.Uuid
  visible         Boolean   @default(false)
  previewedAt     DateTime? @map("previewed_at") @db.Timestamptz(6)
  addedByUserId   String    @map("added_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  registryItem RegistryItem @relation(fields: [registryItemId], references: [id], onDelete: Cascade)
  circle       Circle       @relation(fields: [circleId], references: [id], onDelete: Cascade)
  addedBy      User         @relation("link_added_by", fields: [addedByUserId], references: [id], onDelete: Cascade)

  @@unique([registryItemId, circleId])
  @@index([circleId, visible])
  @@map("circle_item_links")
}
