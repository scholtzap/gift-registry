# Local environment files; reviewed setup/deploy templates remain trackable.
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example
!.env.*.sample
!.env.*.template
.envrc

# Private credentials, not public certificates or deployment manifests.
.secrets/
.credentials/
credentials.json
credentials.*.json
service-account*.json
serviceAccount*.json
!credentials.example.json
!credentials.sample.json
!service-account.example.json
!service-account.sample.json
!serviceAccount.example.json
!serviceAccount.sample.json
*.key
*.p12
*.pfx
*.keystore
*.jks
*-private.pem
*_private.pem
private*.pem
id_rsa
id_ed25519
.npmrc.local
.aws/credentials

