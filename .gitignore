node_modules/
.next/
.next-*/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts
/src/generated/prisma/
/generated/
.pnpm-store/
.npm/
.turbo/
.cache/
.parcel-cache/
.eslintcache
