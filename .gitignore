# Test and coverage output, not committed fixtures.
coverage/
.nyc_output/
htmlcov/
.coverage
.coverage.*
playwright-report/
blob-report/
test-results/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Runtime media and raw recordings only. Keep public/, fixtures/, and design assets.
/.media/
/media/
/uploads/
/recordings/
/.recordings/
# Local demo capture (stills / narration / mp4). Not part of the public tree.
/demo-recording/
/artifacts/
/local-data/
/backups/
*.dump
*.sql.gz

# Local scratch / OS / editor leftovers
.scratch/
.scratchpad/
/tmp/
/temp/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Editors: retain reviewed shared settings, tasks, and extension recommendations.
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
*.code-workspace

# Agent runtime state; shared agent config and project_memory.json stay trackable.
.memory/*.sqlite*
.memory/*.db
.memory/*.db-journal
.memory/*.db-wal
.memory/*.db-shm
.memory/cache/
.omc/sessions/
.omc/state/
.claude/*.local.*
.codex/*.local.*
.cursor/*.local.*
.qoder/cache/
.qoder/logs/
.qoder/sessions/

# Diagram/tool output, not source diagrams.
graphify-out/

# Third-party event-rule page prints are local reference, not redistribution.
# docs/strategy/hackathon-rules-and-rubric.md is our own summary.
docs/strategy/hackathon/*.pdf

# Generated plans-registry reports (regenerate with audit_plans.py).
docs/plans/PLANS_AUDIT_REPORT.md
docs/plans/RELOCATION_MAP.md

# Vendor agent skills installed by CLIs, not submitted product code.
.agents/skills/
.claude/skills/
.windsurf/
skills-lock.json
